{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replyingo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // D1 keeps its original name "replybuilt" so existing data stays attached.
  // No database_id: wrangler creates the D1 database on the first deploy and finds it by name afterwards.
  "d1_databases": [{ "binding": "DB", "database_name": "replybuilt" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "SITE_URL": "https://replyingo.com" },
  "observability": { "enabled": true }
}
